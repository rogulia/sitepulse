# Telegram
TELEGRAM_TOKEN=your-telegram-bot-token
TELEGRAM_CHANNEL_ID=your-channel-id

# Monitoring target
BASE_URL=https://example.com
SITEMAP_PATH=/sitemap.xml

# Domains to check (comma-separated)
# Format: domain1,domain2:expiry=2025-02-11,domain3
DOMAINS_TO_CHECK=example.com,example.net

# Our nameservers (comma-separated)
OUR_NAMESERVERS=ns1.example.com,ns2.example.com
